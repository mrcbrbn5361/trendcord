# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Bot Ayarları
PREFIX=!
CHECK_INTERVAL=3600
PROXY_ENABLED=True
VERIFY_SSL=True

# Web sunucusunun dinledigi adres.
# GUVENLIK: 127.0.0.1 (varsayilan) SADECE yerel — origin IP uzerinden
# dogrudan erisim mumkun olmaz, Boylece Cloudflare WAF/rate-limit/DDoS
# korumasi atlanamaz. Trafik zaten cloudflared tuneliyle yerel gelir.
# Yalniz yerel gelistirme/LAN erisimi icin 0.0.0.0 yap.
WEB_HOST=127.0.0.1

# Veritabanı Ayarları
DATABASE_PATH=data/trendyol_tracker.sqlite

# Web Arayüzü Ayarları
SECRET_KEY=generate_a_random_secret_key_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here
REDIRECT_URI=http://localhost:8000/callback
OWNER_ID=your_discord_user_id_here
PORT=8000

# Resmi Trendcord sunucusu. Destek talepleri ve duyuru gonderme YALNIZCA bu
# sunucuda calisir; sunucuya eklenen her yerde kurulum yine de yapilir.
OFFICIAL_GUILD_ID=your_official_discord_server_id_here

# Bot eklendiginde kanallari otomatik kur (true/false)
AUTO_SETUP_DEFAULT=true

# Session cookie'sine `Secure` bayragi ekler (tarayici yalnizca HTTPS'te gonderir).
# Uretimde 1 birak. Yalnizca yerel HTTP uzerinde gelistirirken 0 yap, aksi halde
# tarayici session cookie'sini gondermez ve CSRF belirteci eslesmez.
COOKIE_SECURE=1

# Cloudflare DNS Failover (dns_failover.py için)
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_zone_id_here
CF_ZONE_NAME=miracdeveloper.com.tr
CF_RECORD_NAME=trendcord.miracdeveloper.com.tr
CF_GITHUB_PAGES=mrcbrbn5361.github.io
CF_TUNNEL_CNAME=a42d6853-0530-41dd-be93-b501a66dd5d3.cfargotunnel.com
