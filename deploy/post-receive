#!/usr/bin/env bash
# ============================================================
# Trendcord — post-receive: sıfır kesintili atomic deploy
#
# Akış:
#   push (main) → releases/<stamp> dizinine temiz checkout
#   → shared/.env ve shared/data bağlanır (veri kaybı yok)
#   → mevcut data/ tar.gz yedeklenir
#   → venv + pip install + py_compile sağlama
#   → current symlink ATOMİK değişir → systemctl restart
#   → servis ayağa kalkmazsa OTOMATİK önceki release'e dönülür
#   → son 5 release saklanır, eskiler silinir
# ============================================================
set -euo pipefail

BASE="/srv/trendcord"
RELEASES="$BASE/releases"
SHARED="$BASE/shared"
BACKUPS="$BASE/backups"
SERVICE="trendcord"
KEEP=5

while read -r OLDREV NEWREV REFNAME; do
    [ "$REFNAME" = "refs/heads/main" ] || exit 0

    STAMP="$(date -u +%Y%m%d-%H%M%S)"
    REL="$RELEASES/$STAMP"
    PREV="$(readlink -f $BASE/current 2>/dev/null || true)"

    echo "==> Trendcord deploy başlıyor: $STAMP"

    # 1) Temiz checkout (git çalışma dizini kirli dosyalar taşınmaz)
    mkdir -p "$REL"
    git archive "$NEWREV" | tar -x -C "$REL"

    # 2) Kalıcı veri ve gizli bilgiler
    ln -sfn "$SHARED/.env" "$REL/.env"
    ln -sfn "$SHARED/data" "$REL/data"

    # 3) Veri yedeği (switch'ten ÖNCE)
    if [ -d "$SHARED/data" ] && [ -n "$(ls -A "$SHARED/data" 2>/dev/null)" ]; then
        tar czf "$BACKUPS/data-$STAMP.tar.gz" -C "$SHARED/data" . 2>/dev/null || true
        echo "    ✓ Veri yedeği: backups/data-$STAMP.tar.gz"
    fi

    # 4) Bağımlılıklar + sözdizimi sağlaması
    python3 -m venv "$REL/venv"
    "$REL/venv/bin/pip" install --upgrade pip --quiet
    "$REL/venv/bin/pip" install -r "$REL/requirements.txt" --quiet
    "$REL/venv/bin/python" -m py_compile "$REL/main.py" \
        || { echo "HATA: py_compile başarısız — release atılıyor"; rm -rf "$REL"; exit 1; }

    # 5) Atomik switch
    ln -sfn "$REL" "$BASE/.current.tmp" && mv -Tf "$BASE/.current.tmp" "$BASE/current"
    echo "    ✓ current -> $STAMP"

    # 6) Servisi yeniden başlat ve doğrula
    sudo systemctl restart "$SERVICE" || true
    sleep 5
    if ! systemctl is-active --quiet "$SERVICE"; then
        echo "!! DEPLOY BAŞARISIZ — önceki sürüme dönülüyor..."
        if [ -n "$PREV" ] && [ -d "$PREV" ]; then
            ln -sfn "$PREV" "$BASE/.current.tmp" && mv -Tf "$BASE/.current.tmp" "$BASE/current"
            sudo systemctl restart "$SERVICE" || true
            echo "    ✓ Geri alındı: $(basename "$PREV") aktif"
        fi
        journalctl -u "$SERVICE" -n 20 --no-pager || true
        rm -rf "$REL"
        exit 1
    fi

    echo "==> Deploy tamam: $STAMP aktif"

    # 7) Eski release'leri temizle (son KEEP adet kalır)
    ls -1t "$RELEASES" | tail -n +$((KEEP + 1)) | while read -r OLD; do
        rm -rf "$RELEASES/$OLD"
    done
done
